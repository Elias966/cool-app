<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark from the first frame: no white flash before the WebView paints. -->
    <style name="Theme.Prism" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/prism_bg</item>
        <item name="android:colorBackground">@color/prism_bg</item>
        <item name="android:colorAccent">#7C5CFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
